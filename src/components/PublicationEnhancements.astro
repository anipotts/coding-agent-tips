---
import { Dialog, DialogContent, DialogDescription, DialogTitle } from './starwind/dialog';
---

<Dialog>
  <DialogContent id="publication-image-dialog" class="publication-image-dialog" data-publication-image-dialog>
    <DialogTitle class="sr-only">image preview</DialogTitle>
    <figure>
      <img data-publication-dialog-image src="" alt="" />
      <DialogDescription data-publication-dialog-caption></DialogDescription>
    </figure>
  </DialogContent>
</Dialog>

<script>
  import { createDialog } from '@starwind-ui/runtime/dialog';
  import { createPreviewCard } from '@starwind-ui/runtime/preview-card';
  import { createScrollArea } from '@starwind-ui/runtime/scroll-area';
  import { createTooltip } from '@starwind-ui/runtime/tooltip';
  import { toast } from '@starwind-ui/astro/toast';

  let cleanupPublicationEnhancements = () => {};

  const setupPublicationEnhancements = () => {
    cleanupPublicationEnhancements();
    const controller = new AbortController();
    const dialogRoot = document.querySelector<HTMLElement>('[data-slot="dialog"]:has([data-publication-image-dialog])');
    const dialog = dialogRoot ? createDialog(dialogRoot) : undefined;
    const dialogImage = dialogRoot?.querySelector<HTMLImageElement>('[data-publication-dialog-image]');
    const dialogCaption = dialogRoot?.querySelector<HTMLElement>('[data-publication-dialog-caption]');
    const previewCards = [...document.querySelectorAll<HTMLElement>('[data-sw-preview-card]')]
      .map((root) => createPreviewCard(root));
    const scrollAreas = [...document.querySelectorAll<HTMLElement>('.publication-scroll-area[data-sw-scroll-area]')]
      .map((root) => createScrollArea(root));
    const codeTooltips = [...document.querySelectorAll<HTMLElement>('.code-frame[data-sw-tooltip]')]
      .map((root) => createTooltip(root));

    document.querySelectorAll<HTMLElement>('.surface-bento figure').forEach((figure) => {
      const image = figure.querySelector<HTMLImageElement>('img');
      const caption = figure.querySelector<HTMLElement>('figcaption');
      if (!image) return;

      let trigger = figure.querySelector<HTMLButtonElement>('[data-publication-image-trigger]');
      if (!trigger) {
        trigger = document.createElement('button');
        trigger.type = 'button';
        trigger.className = 'publication-image-trigger';
        trigger.dataset.publicationImageTrigger = '';
        trigger.setAttribute('aria-label', `open larger view of ${image.alt}`);
        const imageLink = image.closest('a');
        (imageLink ?? image).before(trigger);
        trigger.append(image);
        imageLink?.remove();
      }

      figure.dataset.imageDialogReady = '';

      trigger.addEventListener('click', (event) => {
        if (!dialog || !dialogImage || !dialogCaption) return;
        dialogImage.src = image.dataset.fullSrc || image.currentSrc || image.src;
        dialogImage.alt = image.alt;
        dialogCaption.textContent = caption?.textContent?.trim() ?? '';
        dialog.setOpen(true, { reason: 'imperative-action', event, trigger });
      }, { signal: controller.signal });
    });

    document.querySelectorAll<HTMLButtonElement>('[data-code-copy]').forEach((button) => {
      const pre = button.parentElement?.querySelector('pre');
      if (!pre) return;
      button.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(pre.textContent ?? '');
          button.textContent = 'copied';
          toast.success('code copied');
        } catch {
          toast.error('copy failed', { description: 'The code block could not be copied.' });
        }
        window.setTimeout(() => { button.textContent = 'copy'; }, 1500);
      }, { signal: controller.signal });
    });

    cleanupPublicationEnhancements = () => {
      controller.abort();
      previewCards.forEach((previewCard) => previewCard.destroy());
      scrollAreas.forEach((scrollArea) => scrollArea.destroy());
      codeTooltips.forEach((tooltip) => tooltip.destroy());
    };
  };

  document.addEventListener('astro:page-load', setupPublicationEnhancements);
  setupPublicationEnhancements();
</script>
