---
import Adjustments from '@tabler/icons/outline/adjustments.svg';
import AppWindow from '@tabler/icons/outline/app-window.svg';
import ArrowRight from '@tabler/icons/outline/arrow-right.svg';
import BrandGithub from '@tabler/icons/outline/brand-github.svg';
import ChevronDown from '@tabler/icons/outline/chevron-down.svg';
import Compass from '@tabler/icons/outline/compass.svg';
import GitBranch from '@tabler/icons/outline/git-branch.svg';
import ShieldCheck from '@tabler/icons/outline/shield-check.svg';
import Collapsible from '@starwind-ui/astro/collapsible';
import { routeForEntry, type HandbookEntry } from '../content';
import { chapterOutline } from '../navigation';
import { chapterForOrder, type NavigationScope } from '../site';
import { SidebarMenu, SidebarMenuAction, SidebarMenuButton, SidebarMenuItem, SidebarMenuSub, SidebarMenuSubButton, SidebarMenuSubItem } from './starwind/sidebar';

interface Props {
  pages: HandbookEntry[];
  current: string;
  scope: NavigationScope;
  mode?: 'desktop' | 'mobile';
}
const { pages, current, scope, mode = 'desktop' } = Astro.props;
const chapterIcons = [Compass, ArrowRight, Adjustments, GitBranch, AppWindow, ShieldCheck, Compass];
---

<SidebarMenu class="chapter-menu" data-chapter-menu={mode}>
  {pages.map((page, index) => {
    const href = routeForEntry(page);
    const active = current === href;
    const label = scope === 'handbook' ? page.data.title : chapterForOrder(page.data.navigation.order)?.label ?? page.data.title;
    const NavigationIcon = chapterIcons[index] ?? BrandGithub;
    const headings = chapterOutline(page);
    const panelId = `chapter-outline-${mode}-${page.id.replace(/[^a-zA-Z0-9_-]/g, '-')}`;
    return (
      <SidebarMenuItem class:list={{ 'is-current-chapter': active }} data-chapter-route={href}>
        <Collapsible.Root defaultOpen={active} class="chapter-disclosure">
          <div class="chapter-row">
            <SidebarMenuButton href={href} data-astro-prefetch={mode === 'desktop' ? 'hover' : 'tap'} isActive={active} tooltip={mode === 'desktop' ? label : undefined} size="sm" aria-current={active ? 'page' : undefined} data-sw-drawer-close={mode === 'mobile' ? '' : undefined}>
              <NavigationIcon aria-hidden="true" />
              <span>{label}</span>
            </SidebarMenuButton>
            {headings.length > 0 && <SidebarMenuAction class="chapter-toggle" data-sw-collapsible-trigger aria-label={`toggle ${label} sections`} aria-controls={panelId} aria-expanded={active}>
              <ChevronDown aria-hidden="true" />
            </SidebarMenuAction>}
          </div>
          {headings.length > 0 && <Collapsible.Panel id={panelId} class="chapter-outline-panel" hidden={!active} data-state={active ? 'open' : 'closed'}>
            <SidebarMenuSub class={mode === 'mobile' ? 'sidebar-page-outline mobile-page-outline' : 'sidebar-page-outline'} aria-label={`${label} sections`}>
              {headings.map((heading) => <SidebarMenuSubItem style={`--heading-depth: ${heading.depth - 2}`} data-heading-depth={heading.depth}>
                <SidebarMenuSubButton href={`${active ? '' : href}#${heading.slug}`} data-heading-id={active ? heading.slug : undefined} size="sm" data-sw-drawer-close={mode === 'mobile' ? '' : undefined}>
                  <span>{heading.text}</span>
                </SidebarMenuSubButton>
              </SidebarMenuSubItem>)}
            </SidebarMenuSub>
          </Collapsible.Panel>}
        </Collapsible.Root>
      </SidebarMenuItem>
    );
  })}
</SidebarMenu>
