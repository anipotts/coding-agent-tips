---
interface Props {
  light: string;
  dark?: string;
  size?: number;
  loading?: 'eager' | 'lazy';
  class?: string;
}

const {
  light,
  dark,
  size = 24,
  loading,
  class: className,
} = Astro.props;
---

<span
  class:list={['provider-product-icon', className, { 'has-theme-pair': Boolean(dark) }]}
  style={`--provider-product-icon-size: ${size}px`}
  aria-hidden="true"
>
  <img class="provider-product-icon-light" src={light} alt="" width={size} height={size} loading={loading} />
  {dark && <img class="provider-product-icon-dark" src={dark} alt="" width={size} height={size} loading={loading} />}
</span>
