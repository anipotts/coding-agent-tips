---
import Search from '@astrojs/starlight/components/Search.astro';
import BrandGithub from '@tabler/icons/outline/brand-github.svg';
import Menu2 from '@tabler/icons/outline/menu-2.svg';
import ChevronDown from '@tabler/icons/outline/chevron-down.svg';
import Adjustments from '@tabler/icons/outline/adjustments.svg';
import AppWindow from '@tabler/icons/outline/app-window.svg';
import ArrowRight from '@tabler/icons/outline/arrow-right.svg';
import Book from '@tabler/icons/outline/book.svg';
import Compass from '@tabler/icons/outline/compass.svg';
import GitBranch from '@tabler/icons/outline/git-branch.svg';
import Home from '@tabler/icons/outline/home.svg';
import ShieldCheck from '@tabler/icons/outline/shield-check.svg';
import { getHandbookPages, routeForEntry, scopeForPath } from '../content';
import ChapterMenu from './ChapterMenu.astro';
import ProviderProductIcon from './ProviderProductIcon.astro';
import { chapterForOrder, navigationScopes, site } from '../site';
import { Button } from './starwind/button';
import { Dropdown, DropdownContent, DropdownGroup, DropdownLabel, DropdownLinkItem, DropdownTrigger } from './starwind/dropdown';
import { Sheet, SheetContent, SheetHeader, SheetTitle, SheetTrigger } from './starwind/sheet';
import { ThemeToggle } from './starwind/theme-toggle';
import { Toaster } from './starwind/toast';
import { Tooltip, TooltipContent, TooltipTrigger } from './starwind/tooltip';

const current = Astro.url.pathname;
const HeaderTag = Astro.props.embedded ? 'div' : 'header';
const activeScope = await scopeForPath(current);
const pages = await getHandbookPages();
const activeScopeLabel = navigationScopes.find((scope) => scope.id === activeScope)?.label ?? 'handbook';
const mobileNavigationLabel = (page: (typeof pages)[number]) => page.data.navigation.scope === 'handbook'
  ? page.data.title
  : chapterForOrder(page.data.navigation.order)?.label ?? page.data.title;
const activePage = pages.find((page) => routeForEntry(page) === current);
const selectedPageLabel = activePage ? `${activeScopeLabel}: ${mobileNavigationLabel(activePage)}` : 'handbook';
const scopePages = pages.filter((page) => page.data.navigation.scope === activeScope);
const chapterIcons = {
  'ph:book-open-text': Book, 'ph:arrow-right': ArrowRight,
  'ph:sliders-horizontal': Adjustments, 'ph:git-branch': GitBranch,
  'ph:app-window': AppWindow, 'ph:shield-check': ShieldCheck, 'ph:compass': Compass,
} as const;
---

<HeaderTag class="site-header">
  <div class="header-main">
    <a class="site-name" href="/" aria-label={site.interfaceCopy.home}>
      <img src="/favicon.svg" alt="" width="24" height="24" />
      <span>{site.name}</span>
    </a>
    <div class="header-actions">
      <div class="header-search" transition:persist><Search /></div>
      <ThemeToggle class="site-header-control" variant="default" size="sm" ariaLabel="toggle color theme" />
      <Tooltip class="header-github">
        <TooltipTrigger>
          <Button
            class="github-link site-header-control"
            variant="ghost"
            size="icon-sm"
            href={site.repository}
            aria-label={site.interfaceCopy.github}
          >
            <BrandGithub aria-hidden="true" />
          </Button>
        </TooltipTrigger>
        <TooltipContent side="bottom">GitHub</TooltipContent>
      </Tooltip>
      <Sheet>
        <SheetTrigger asChild>
          <Button
            class="mobile-site-menu-trigger site-header-control"
            variant="ghost"
            size="icon-sm"
            aria-label={site.interfaceCopy.menu}
          >
            <Menu2 aria-hidden="true" />
          </Button>
        </SheetTrigger>
        <SheetContent class="mobile-site-menu" side="right">
          <SheetHeader class="mobile-menu-heading">
            <SheetTitle>{site.interfaceCopy.guides}</SheetTitle>
          </SheetHeader>
          <div class="mobile-page-picker">
            <Dropdown>
              <DropdownTrigger asChild>
                <Button class="mobile-page-picker-trigger" variant="outline" size="sm" aria-label={site.interfaceCopy.choosePage}>
                  <span>{selectedPageLabel}</span><ChevronDown aria-hidden="true" />
                </Button>
              </DropdownTrigger>
              <DropdownContent class="mobile-page-options" align="start">
                <div class="mobile-page-options-scroll" tabindex="0" role="group" aria-label="all handbook pages">
                {navigationScopes.map((scope) => (
                  <DropdownGroup>
                    <DropdownLabel>
                      <ProviderProductIcon light={scope.providerIcon} dark={'providerIconDark' in scope ? scope.providerIconDark : undefined} size={16} loading="lazy" />
                      <span>{scope.label}</span>
                    </DropdownLabel>
                    {scope.id === 'handbook' && <DropdownLinkItem href="/" closeOnClick data-sw-drawer-close><Home aria-hidden="true" /><span>handbook home</span></DropdownLinkItem>}
                    {pages.filter((page) => page.data.navigation.scope === scope.id).map((page) => {
                      const chapter = chapterForOrder(page.data.navigation.order);
                      const PageIcon = chapter ? chapterIcons[chapter.icon] : Book;
                      return (
                        <DropdownLinkItem href={routeForEntry(page)} closeOnClick data-sw-drawer-close data-astro-prefetch="tap" aria-current={current === routeForEntry(page) ? 'page' : undefined}>
                          <PageIcon aria-hidden="true" /><span>{mobileNavigationLabel(page)}</span>
                        </DropdownLinkItem>
                      );
                    })}
                  </DropdownGroup>
                ))}
                </div>
              </DropdownContent>
            </Dropdown>
          </div>
          <nav class="mobile-page-navigation" aria-label={`${activeScopeLabel} handbook chapters`}>
            <ChapterMenu pages={scopePages} current={current} scope={activeScope} mode="mobile" />
          </nav>
          <div class="mobile-menu-footer">
            {current === `/guides/${activeScope}/` && <Button href={site.crashCourse.href} variant="ghost" size="sm" data-sw-drawer-close>
              <Book aria-hidden="true" /><span>{site.crashCourse.label}</span>
            </Button>}
            <Button href={site.repository} variant="ghost" size="sm" data-sw-drawer-close>
              <BrandGithub aria-hidden="true" />
              <span>GitHub</span>
            </Button>
          </div>
        </SheetContent>
      </Sheet>
    </div>
  </div>
  <nav class="provider-tabs" aria-label={site.interfaceCopy.guides}>
    {navigationScopes.map((scope) => (
      <a href={scope.href} data-astro-prefetch="hover" aria-current={activeScope === scope.id ? 'page' : undefined}>
        <span class="provider-tab-highlight" aria-hidden="true"></span>
        <span class="provider-tab-label">{scope.label}</span>
      </a>
    ))}
  </nav>
</HeaderTag>
<Toaster position="bottom-right" duration={3200} />

<script>
  // Pagefind currently exposes a title-only input label and no input-attribute
  // configuration. Supply an explicit accessible name without owning search state.
  let labelObserver: MutationObserver | undefined;
  const labelSearch = () => {
    labelObserver?.disconnect();
    const search = document.querySelector('.header-search');
    if (!search) return;
    const labelInput = () => {
      const input = search.querySelector('input');
      if (!input) return false;
      input.setAttribute('aria-label', input.title || 'Search');
      labelObserver?.disconnect();
      return true;
    };
    if (labelInput()) return;
    labelObserver = new MutationObserver(labelInput);
    labelObserver.observe(search, { childList: true, subtree: true });
  };
  document.addEventListener('astro:page-load', labelSearch);
  document.addEventListener('astro:before-swap', () => labelObserver?.disconnect());
  labelSearch();
</script>
