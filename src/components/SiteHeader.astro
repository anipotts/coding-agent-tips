---
import Search from '@astrojs/starlight/components/Search.astro';
import BrandGithub from '@tabler/icons/outline/brand-github.svg';
import Menu2 from '@tabler/icons/outline/menu-2.svg';
import Book from '@tabler/icons/outline/book.svg';
import { getHandbookPages, scopeForPath } from '../content';
import ChapterMenu from './ChapterMenu.astro';
import { navigationScopes, site } from '../site';
import GuidePicker from './GuidePicker.astro';
import { Button } from './starwind/button';
import { Sheet, SheetContent, SheetHeader, SheetTitle, SheetTrigger } from './starwind/sheet';
import { ThemeToggle } from './starwind/theme-toggle';
import { Toaster } from './starwind/toast';
import { Tooltip, TooltipContent, TooltipTrigger } from './starwind/tooltip';

const current = Astro.url.pathname;
const HeaderTag = Astro.props.embedded ? 'div' : 'header';
const activeScope = await scopeForPath(current);
const pages = await getHandbookPages();
const activeScopeLabel = navigationScopes.find((scope) => scope.id === activeScope)?.label ?? 'handbook';
const scopePages = pages.filter((page) => page.data.navigation.scope === activeScope);
---

<HeaderTag class:list={['site-header', { 'homepage-header': !Astro.props.embedded }]}>
  <div class="header-main">
    <a class="site-name" href="/" aria-label={site.interfaceCopy.home}>
      <img src="/favicon.svg" alt="" width="24" height="24" />
      <span>{site.name}</span>
    </a>
    <div class="header-actions">
      {!Astro.props.embedded && <div class="header-guide-picker"><GuidePicker placement="header" /></div>}
      <div class="header-search" transition:persist><Search /></div>
      <ThemeToggle class="site-header-control" variant="default" size="sm" ariaLabel="toggle color theme" />
      <Tooltip class="header-github">
        <TooltipTrigger>
          <Button
            class="github-link site-header-control"
            variant="ghost"
            size="icon-sm"
            href={site.repository}
            aria-label={site.interfaceCopy.github}
          >
            <BrandGithub aria-hidden="true" />
          </Button>
        </TooltipTrigger>
        <TooltipContent side="bottom">GitHub</TooltipContent>
      </Tooltip>
      <Sheet>
        <SheetTrigger asChild>
          <Button
            class="mobile-site-menu-trigger site-header-control"
            variant="ghost"
            size="icon-sm"
            aria-label={site.interfaceCopy.menu}
          >
            <Menu2 aria-hidden="true" />
          </Button>
        </SheetTrigger>
        <SheetContent class="mobile-site-menu" side="right">
          <SheetHeader class="mobile-menu-heading">
            <SheetTitle>{site.interfaceCopy.guides}</SheetTitle>
          </SheetHeader>
          <div class="mobile-page-picker"><GuidePicker placement="mobile" /></div>
          <nav class="mobile-page-navigation" aria-label={`${activeScopeLabel} handbook chapters`}>
            <ChapterMenu pages={scopePages} current={current} scope={activeScope} mode="mobile" />
          </nav>
          <div class="mobile-menu-footer">
            {current === `/guides/${activeScope}/` && <Button href={site.crashCourse.href} variant="ghost" size="sm" data-sw-drawer-close>
              <Book aria-hidden="true" /><span>{site.crashCourse.label}</span>
            </Button>}
            <Button href={site.repository} variant="ghost" size="sm" data-sw-drawer-close>
              <BrandGithub aria-hidden="true" />
              <span>GitHub</span>
            </Button>
          </div>
        </SheetContent>
      </Sheet>
    </div>
  </div>
</HeaderTag>
<Toaster position="bottom-right" duration={3200} />

<script>
  // Pagefind currently exposes a title-only input label and no input-attribute
  // configuration. Supply an explicit accessible name without owning search state.
  let labelObserver: MutationObserver | undefined;
  const labelSearch = () => {
    labelObserver?.disconnect();
    const search = document.querySelector('.header-search');
    if (!search) return;
    const labelInput = () => {
      const input = search.querySelector('input');
      if (!input) return false;
      input.setAttribute('aria-label', input.title || 'Search');
      labelObserver?.disconnect();
      return true;
    };
    if (labelInput()) return;
    labelObserver = new MutationObserver(labelInput);
    labelObserver.observe(search, { childList: true, subtree: true });
  };
  document.addEventListener('astro:page-load', labelSearch);
  document.addEventListener('astro:before-swap', () => labelObserver?.disconnect());
  labelSearch();
</script>
