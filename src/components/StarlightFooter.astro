---
import DefaultFooter from '@astrojs/starlight/components/Footer.astro';
import AuthorAttribution from './AuthorAttribution.astro';
import ArrowUpRight from '@tabler/icons/outline/arrow-up-right.svg';
import registry from '../../editorial/sources.json';
import PublicationEnhancements from './PublicationEnhancements.astro';
import { Accordion, AccordionContent, AccordionItem, AccordionTrigger } from './starwind/accordion';

const entry = Astro.locals.starlightRoute.entry;
const showSources = Array.isArray(entry.data.sources);
const sourceById = new Map(registry.sources.map((source) => [source.id, source]));
const publisherById = new Map(registry.publishers.map((publisher) => [publisher.id, publisher]));
const pageSources = (entry.data.sources ?? []).map((id) => sourceById.get(id)).filter((source) => source !== undefined);
const pageSourceGroups = [...pageSources.reduce((groups, source) => {
  const sources = groups.get(source.publisher) ?? [];
  sources.push(source);
  groups.set(source.publisher, sources);
  return groups;
}, new Map<string, typeof pageSources>())].map(([publisherId, sources]) => ({
  publisher: publisherById.get(publisherId),
  sources,
})).filter((group) => group.publisher !== undefined);
const sourceCountLabel = `${pageSources.length} ${pageSources.length === 1 ? 'source' : 'sources'}`;
---

{showSources && <Accordion class="page-sources" type="single" collapsible>
  <AccordionItem value="sources">
  <AccordionTrigger class="source-summary">
    <span id="page-sources-title" class="source-summary-title" role="heading" aria-level="2">sources</span>
    {pageSourceGroups.length > 0 && <span class="source-summary-badge" aria-label={sourceCountLabel}>
      <span class="source-summary-publishers" aria-hidden="true">
        {pageSourceGroups.map(({ publisher }) => <span class="publisher-icon-frame"><img src={publisher!.icon} alt="" width="20" height="20" loading="lazy" /></span>)}
      </span>
      <sup class="source-summary-count" aria-hidden="true">{pageSources.length}</sup>
    </span>}
  </AccordionTrigger>
  <AccordionContent>
  <div class="source-groups" aria-labelledby="page-sources-title">
    {pageSourceGroups.length > 0 ? pageSourceGroups.map(({ publisher, sources }) => <section class="source-publisher">
      <h3>
        <span class="publisher-icon-frame"><img src={publisher!.icon} alt="" width="20" height="20" loading="lazy" /></span>
        <span>{publisher!.label}</span>
        <span class="source-domain">{publisher!.domain}</span>
      </h3>
      <ul>
        {sources.map((source) => <li><a href={source.url}>
          <span>{source.title}</span>
          <ArrowUpRight aria-hidden="true" />
        </a></li>)}
      </ul>
    </section>) : <p>this page is based on the author’s own working notes and linked examples.</p>}
  </div>
  </AccordionContent>
  </AccordionItem>
</Accordion>}
<PublicationEnhancements />
<div class="publication-author"><AuthorAttribution /></div>
<DefaultFooter />

<style>
  .page-sources { margin-top: 4rem; border: 1px solid var(--rule); border-radius: var(--radius-md); background: var(--surface-raised); overflow: clip; }
  .page-sources ul { margin: 0; padding: 0; list-style: none; }
  .page-sources .source-summary { min-height: 3rem; display: grid; grid-template-columns: minmax(0, 1fr) auto 1rem; align-items: center; gap: .75rem; padding: .55rem .75rem; text-decoration: none; }
  .page-sources .source-summary:hover { background: var(--soft); }
  .source-summary-badge { position: relative; display: inline-grid; place-items: center; min-inline-size: 1.5rem; min-block-size: 1.5rem; }
  .source-summary-publishers { display: flex; align-items: center; }
  .publisher-icon-frame { display: grid; place-items: center; inline-size: 1.45rem; block-size: 1.45rem; padding: .12rem; border: 1px solid var(--rule); border-radius: .32rem; background: #fff; overflow: hidden; }
  .source-summary-publishers .publisher-icon-frame + .publisher-icon-frame { margin-inline-start: -.35rem; }
  .publisher-icon-frame img { display: block; inline-size: 100%; block-size: 100%; border-radius: .16rem; object-fit: contain; }
  .source-summary-count { position: absolute; inset: -.45rem -.55rem auto auto; min-inline-size: 1.15rem; block-size: 1.15rem; display: grid; place-items: center; padding: 0 .18rem; border: 2px solid var(--surface-raised); border-radius: var(--radius-pill); background: var(--cobalt); color: var(--accent-on-solid); }
  .source-groups { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.5rem 2rem; padding: 1.25rem; background: color-mix(in srgb, var(--surface-subtle) 42%, var(--surface-raised)); }
  .source-publisher { min-width: 0; margin: 0; padding: 0; }
  .source-publisher:only-child { grid-column: 1 / -1; }
  .source-publisher + .source-publisher { margin-top: 0; border-top: 0; }
  .source-publisher h3 { display: grid; grid-template-columns: 1.45rem auto minmax(0, 1fr); align-items: center; gap: .55rem; margin: 0 0 .65rem; }
  .source-publisher ul { display: grid; grid-template-columns: 1fr; gap: .2rem; }
  .source-publisher:only-child ul { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .source-domain { justify-self: end; color: var(--slate); }
  .page-sources li { min-width: 0; padding: 0; border: 0; }
  .page-sources li + li { margin-top: 0; }
  .page-sources a {
    display: grid;
    grid-template-columns: minmax(0, 1fr) .9rem;
    align-items: center;
    gap: .6rem;
    min-height: 2.4rem;
    padding: .5rem .6rem;
    border-radius: var(--radius-sm);
    color: var(--ink);
    text-decoration: none;
    transition: color var(--motion-ui-duration) var(--motion-ui-ease), background-color var(--motion-ui-duration) var(--motion-ui-ease);
  }
  .page-sources a svg { inline-size: .85rem; block-size: .85rem; color: var(--slate); opacity: .68; transition: color var(--motion-ui-duration) var(--motion-ui-ease), opacity var(--motion-ui-duration) var(--motion-ui-ease), transform var(--motion-ui-duration) var(--motion-ui-ease); }
  .page-sources a:hover, .page-sources a:focus-visible { background: var(--soft); color: var(--cobalt); }
  .page-sources a:hover svg, .page-sources a:focus-visible svg { color: var(--cobalt); opacity: 1; transform: translate(.08rem, -.08rem); }
  @media (max-width: 48rem) {
    .run-inventory li { grid-template-columns: 1fr; gap: .35rem; }
    .page-sources .source-summary { grid-template-columns: minmax(0, 1fr) auto 1rem; }
    .source-groups { grid-template-columns: 1fr; gap: 1.25rem; padding: 1rem; }
    .source-publisher:only-child ul { grid-template-columns: 1fr; }
    .source-domain { display: none; }
  }
</style>
