---
import Check from '@tabler/icons/outline/check.svg';
import ChevronDown from '@tabler/icons/outline/chevron-down.svg';
import Copy from '@tabler/icons/outline/copy.svg';
import Edit from '@tabler/icons/outline/edit.svg';
import FileText from '@tabler/icons/outline/file-text.svg';
import Link from '@tabler/icons/outline/link.svg';
import { formatUpdatedAt } from '../date';
import { scopeForPath, site } from '../site';
import { Button } from './starwind/button';
import { ButtonGroup } from './starwind/button-group';
import {
  Dropdown,
  DropdownContent,
  DropdownItem,
  DropdownLinkItem,
  DropdownTrigger,
} from './starwind/dropdown';

const entry = Astro.locals.starlightRoute.entry;
const { title, updatedAt, draft } = entry.data;
const markdownPath = `${Astro.url.pathname.replace(/\/$/, '') || '/index'}.md`;
const editPath = `${site.repository}/edit/main/content/${entry.id}.md`;
const isProviderGuide = scopeForPath(Astro.url.pathname) !== 'handbook';
---

<div class:list={['page-title-row', { 'provider-guide-title-row': isProviderGuide }]}>
  <h1 id="_top">{title}</h1>
  {!draft && (
    <ButtonGroup class="page-actions" aria-label="page actions" data-pagefind-ignore>
      <Button
        class="page-copy-button"
        variant="outline"
        size="sm"
        data-copy-page
        data-markdown-path={markdownPath}
        aria-label="copy page as Markdown"
      >
        <Copy data-copy-page-icon aria-hidden="true" />
        <span data-copy-page-success-icon hidden><Check aria-hidden="true" /></span>
        <span data-copy-page-label>copy page</span>
      </Button>
      <Dropdown>
        <DropdownTrigger asChild>
          <Button variant="outline" size="icon-sm" aria-label="more page actions">
            <ChevronDown aria-hidden="true" />
          </Button>
        </DropdownTrigger>
        <DropdownContent align="end" class="page-actions-dropdown">
          <DropdownLinkItem href={markdownPath} target="_blank" rel="noopener" closeOnClick>
            <FileText aria-hidden="true" /><span>view Markdown</span>
          </DropdownLinkItem>
          <DropdownItem data-copy-page-link>
            <Link aria-hidden="true" /><span>copy page link</span>
          </DropdownItem>
          <DropdownLinkItem href={editPath} closeOnClick>
            <Edit aria-hidden="true" /><span>edit on GitHub</span>
          </DropdownLinkItem>
        </DropdownContent>
      </Dropdown>
    </ButtonGroup>
  )}
</div>
{updatedAt && (
  <p class="page-meta" aria-label="page metadata">
    <span>{site.interfaceCopy.lastUpdated} <time datetime={updatedAt}>{formatUpdatedAt(updatedAt)}</time></span>
  </p>
)}

<script>
  import { toast } from '@starwind-ui/astro/toast';
  import { createMenu } from '@starwind-ui/runtime/menu';

  let cleanupPageActions = () => {};
  const setupPageActions = () => {
    cleanupPageActions();
    const controller = new AbortController();

    // Page actions belong to their title row. Let Starwind close its own menu
    // when the document moves, without interrupting scrolling within an overlay.
    document.addEventListener('scroll', (event) => {
      if (event.target !== document) return;
      document.querySelectorAll<HTMLElement>('.page-actions [data-sw-menu][data-state="open"]').forEach((root) => {
        createMenu(root).close();
      });
    }, { passive: true, signal: controller.signal });

    document.querySelectorAll<HTMLButtonElement>('[data-copy-page]').forEach((button) => {
      let markdownRequest: Promise<string> | undefined;
      const getMarkdown = () => markdownRequest ??= fetch(button.dataset.markdownPath ?? '', {
        headers: { accept: 'text/markdown' },
      }).then((response) => {
        if (!response.ok) throw new Error('page Markdown is unavailable');
        return response.text();
      });

      button.addEventListener('click', async () => {
        const label = button.querySelector<HTMLElement>('[data-copy-page-label]');
        const copyIcon = button.querySelector<HTMLElement>('[data-copy-page-icon]');
        const successIcon = button.querySelector<HTMLElement>('[data-copy-page-success-icon]');
        try {
          await navigator.clipboard.writeText(await getMarkdown());
          if (label) label.textContent = 'copied';
          if (copyIcon) copyIcon.hidden = true;
          if (successIcon) successIcon.hidden = false;
          toast.success('page copied', { description: 'Markdown is ready to paste.' });
        } catch {
          toast.error('copy failed', { description: 'Page Markdown could not be copied.' });
        }
        window.setTimeout(() => {
          if (label) label.textContent = 'copy page';
          if (copyIcon) copyIcon.hidden = false;
          if (successIcon) successIcon.hidden = true;
        }, 1800);
      }, { signal: controller.signal });
    });

    document.querySelectorAll<HTMLElement>('[data-copy-page-link]').forEach((item) => {
      item.addEventListener('click', async () => {
        const url = new URL(location.href);
        url.hash = '';
        try {
          await navigator.clipboard.writeText(url.href);
          toast.success('link copied', { description: 'The canonical page URL is ready to paste.' });
        } catch {
          toast.error('copy failed', { description: 'The page link could not be copied.' });
        }
      }, { signal: controller.signal });
    });

    cleanupPageActions = () => controller.abort();
  };

  document.addEventListener('astro:page-load', setupPageActions);
  setupPageActions();
</script>
